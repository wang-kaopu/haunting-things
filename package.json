{
  "name": "haunting-things",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A trimmed Claude/Codex team workspace inspired by AionUi.",
  "license": "Apache-2.0",
  "main": "dist-server/electron/main.js",
  "scripts": {
    "dev:web": "npm run build:renderer && tsx src/server/index.ts",
    "dev:remote": "npm run build:renderer && ALLOW_REMOTE=true tsx src/server/index.ts",
    "dev:desktop": "npm run build && electron dist-server/electron/main.js",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:renderer && npm run build:server",
    "start": "node dist-server/server/index.js",
    "start:remote": "ALLOW_REMOTE=true node dist-server/server/index.js",
    "reset-password": "node dist-server/server/index.js --reset-password",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.18.2",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.4.1",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie": "^1.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.10.3",
    "esbuild": "^0.25.11",
    "tsx": "^4.19.1",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  }
}
